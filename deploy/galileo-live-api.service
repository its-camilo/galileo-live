[Unit]
Description=Galileo Live API (FastAPI)
After=network-online.target

[Service]
WorkingDirectory=/data/galileo-live
EnvironmentFile=/data/galileo-live/.env
Environment=PATH=/data/galileo-live/bin:/usr/local/bin:/usr/bin:/bin
Environment=GALILEO_DATA_DIR=/data/galileo-live/data
Environment=XDG_CACHE_HOME=/data/galileo-live/data/cache
Environment=MPLCONFIGDIR=/data/galileo-live/data/mpl
ExecStart=/data/galileo-live/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8443 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-server-header --limit-concurrency 40 --timeout-keep-alive 5
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/data/galileo-live/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
