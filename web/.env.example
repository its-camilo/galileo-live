# Auth.js (Next.js) - keep these server-side only
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Shared HS256 secret with the VPS API (APP_JWT_SECRET in /data/galileo-live/.env)
APP_JWT_SECRET=
APP_JWT_AUDIENCE=galileo-vps

# Public URL of the VPS API (Tailscale Funnel), used by the client
NEXT_PUBLIC_API_URL=https://<tailscale-funnel-host>:8443
